from src.data_loader import fetch_equity_returns
from src.pca_model import PCAFactorModel
from src.residuals import extract_idiosyncratic_residuals

# Define asset universe (e.g. liquid tech constituents)
tickers = [
    "AAPL",
    "MSFT",
    "GOOGL",
    "AMZN",
    "NVDA",
    "META",
    "TSLA",
    "AMD",
    "INTC",
    "QCOM",
]
returns = fetch_equity_returns(tickers, start_date="2020-01-01", end_date="2025-01-01")

# Fit PCA
pca = PCAFactorModel(n_components=3)
pca.fit(returns)

print(
    "Variance Explained by Top 3 PCs:", pca.explained_variance_ratio[:3].sum()
)

# Extract spreads
residuals, spreads = extract_idiosyncratic_residuals(
    returns, pca.factor_returns
)
spreads.plot(title="Cumulative Idiosyncratic Spreads", figsize=(12, 6))
