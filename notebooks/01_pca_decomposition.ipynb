from src.clustering import FactorClusterer
from src.data_loader import fetch_equity_returns
from src.ou_process import OUProcessModel
from src.pca_model import PCAFactorModel
from src.residuals import extract_idiosyncratic_residuals

# 1. Fetch Universe Data
tickers = [
    "AAPL",
    "MSFT",
    "GOOGL",
    "AMZN",
    "NVDA",
    "META",
    "TSLA",
    "AMD",
    "INTC",
    "QCOM",
    "JPM",
    "BAC",
    "WFC",
    "C",
    "GS",
]
returns = fetch_equity_returns(tickers, start_date="2023-01-01", end_date="2025-01-01")

# 2. Extract Top Systematic Factors via PCA
pca = PCAFactorModel(n_components=4)
pca.fit(returns)

# 3. Dynamic Asset Clustering via DBSCAN on Factor Loadings
clusterer = FactorClusterer(eps=1.2, min_samples=2)
clusterer.fit(pca.factor_loadings)
clusters = clusterer.get_clusters()

print("Discovered Clusters:")
for cid, members in clusters.items():
    if cid == -1:
        print(f"  Noise / Unclustered Outliers ({len(members)}): {members}")
    else:
        print(f"  Cluster {cid} ({len(members)} assets): {members}")

# 4. Filter Idiosyncratic Residuals & Fit OU Process for Cohesive Clusters
residuals, cumulative_spreads = extract_idiosyncratic_residuals(
    returns, pca.factor_returns
)
ou_model = OUProcessModel()

# Calibrate OU parameters for all non-noise clustered assets
for cid, members in clusters.items():
    if cid == -1:
        continue
    print(f"\n--- OU Calibration for Cluster {cid} ---")
    for ticker in members:
        params = ou_model.fit_spread(cumulative_spreads[ticker])
        print(
            f"Asset: {ticker:<5} | Half-Life: {params['half_life']:.2f} days | Kappa: {params['kappa']:.2f} | Sigma_eq: {params['sigma_eq']:.4f}"
        )
